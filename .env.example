# Public URL of this server (must be https for phones / the iOS app)
BASE_URL=http://localhost:3000
PORT=3000
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=
# Optional: only these Google accounts may sign in (comma separated). Strongly recommended.
ALLOWED_EMAILS=
# Optional: where the SQLite database lives
DB_PATH=./data/tempo.db
